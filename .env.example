# ShopSnap — every value below is OPTIONAL. With nothing set the app runs
# end-to-end on seeded in-memory data with the mock payment provider.

# --- backend (apps/backend) ---
# Injected at deploy; 8000 is only a dev fallback.
PORT=8000
# Comma-separated browser origins allowed to call the API (the frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# Force the mock payment provider to decline (values: decline). Demo/testing only.
PAYMENT_MOCK_OUTCOME=

# --- payments integration seam (apps/backend/src/integrations/payments) ---
# Set this TEST key to switch the factory from MockPayments to StripePayments.
# Get it from the Stripe Dashboard > Developers > API keys (use a sk_test_ key).
STRIPE_SECRET_KEY=
# Publishable key for a future client-side Stripe element (a pk_test_ key).
STRIPE_PUBLISHABLE_KEY=

# --- future data store (not used today; the seed repository is the default) ---
# Postgres connection string from your database provider's dashboard.
DATABASE_URL=

# --- frontend (apps/frontend) ---
# Baked into the static bundle at BUILD time by Vite.
VITE_BACKEND_URL=http://localhost:8000
